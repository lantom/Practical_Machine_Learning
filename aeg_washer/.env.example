# Údaje z https://developer.electrolux.one (Dashboard -> API Key + Generate token)
ELX_API_KEY=
ELX_ACCESS_TOKEN=
ELX_REFRESH_TOKEN=

# Volitelné: konkrétní spotřebič (jinak se vybere první pračka na účtu)
APPLIANCE_ID=

# Volitelné: ochrana lokálního API heslem (hlavička X-API-Token nebo ?token=)
LOCAL_API_TOKEN=

# Kam ukládat obnovované tokeny (refresh token se při každé obnově mění!)
TOKEN_FILE=data/tokens.json

# Záložní dotaz na stav v sekundách (hlavní zdroj je livestream)
POLL_INTERVAL=300

# Průběžná notifikace na telefonu (Android, aplikace ntfy) – téma s náhodným názvem,
# např. https://ntfy.sh/pracka-3f9c1a7b2e. Prázdné = bez notifikací.
NTFY_URL=

# Časové pásmo pro odhad konce programu
TZ=Europe/Prague
